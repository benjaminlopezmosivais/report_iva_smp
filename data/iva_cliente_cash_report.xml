    <!-- REPORTE -->
    <record id="report_iva_cliente_cash" model="account.report">
        <field name="name">IVA por Cliente (Flujo Fiscal)</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="custom_handler_model_id" ref="iva_cliente_cash_report.model_report_iva_cliente_cash_handler"/>
    </record>
    
    <!-- Datos generales -->
    <record id="col_partner" model="account.report.column"><field name="report_id" ref="report_iva_cliente_cash"/>
